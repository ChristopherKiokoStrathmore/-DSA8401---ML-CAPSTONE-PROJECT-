# Base URL of this repo's FastAPI service. No trailing slash, and no /predict suffix.
# The app calls {NEXT_PUBLIC_API_URL}/health, /predict, and /predict_batch.
#
# Local: copy to .env.local, then restart `npm run dev`.
#   NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Vercel: set the same variable, then redeploy. NEXT_PUBLIC_* is baked in at build time.
# After `modal deploy`, set it to the printed Modal URL. Until that deploy, the
# submission cover uses the placeholder LIVE_DEMO_URL.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
